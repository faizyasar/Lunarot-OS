{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/effects/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/lunarot-baseball/**",
              "ui_kits/sacred-draw/**",
              "ui_kits/sefirot-codex/**",
              "ui_kits/sigil-generator/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Onryou|IPAexMincho|Cinzel|Cormorant Garamond|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Onryou, IPAexMincho, Cinzel, Cormorant Garamond, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|full|disabled|glyph|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, full, disabled, glyph, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HoverText'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|style|key|ref|className|style|children)$/]",
        "message": "<HoverText> doesn't accept that prop. Declared props: text, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InputOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<InputOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|children|onClick|key|ref|className|style|children)$/]",
        "message": "<NavButton> doesn't accept that prop. Declared props: active, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavButton'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<NavButton> active must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tag|footerTag|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: variant, tag, footerTag, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gold|white)$/]",
        "message": "<Panel> variant must be one of 'gold' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TarotCardData'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|num|glyph|key|ref|className|style|children)$/]",
        "message": "<TarotCardData> doesn't accept that prop. Declared props: name, num, glyph."
      },
      {
        "selector": "JSXOpeningElement[name.name='Typewriter'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|chargedList|style|key|ref|className|style|children)$/]",
        "message": "<Typewriter> doesn't accept that prop. Declared props: text, chargedList, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
